<style>
:root {
  --ink: #0d0d14;
  --paper: #f7f5f0;
  --cream: #edeae3;
  --accent: #3b5bdb;
  --accent-light: #dde3ff;
  --green: #2f9e44;
  --green-light: #d3f9d8;
  --amber: #e67700;
  --amber-light: #fff3bf;
  --purple: #7c3aed;
  --purple-light: #ede9fe;
  --text: #1a1a2e;
  --muted: #6b6b80;
  --border: rgba(13,13,20,0.1);
  --card: #ffffff;
  --serif: 'Syne', sans-serif;
  --body: 'Instrument Sans', sans-serif;
  --mono: 'JetBrains Mono', monospace;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--paper);color:var(--text);font-family:var(--body);font-size:16px;line-height:1.7;overflow-x:hidden;}
.cursor-glow{width:400px;height:400px;background:radial-gradient(circle,rgba(59,91,219,0.07) 0%,transparent 70%);position:fixed;pointer-events:none;z-index:0;transform:translate(-50%,-50%);border-radius:50%;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:0 3rem;height:64px;display:flex;align-items:center;justify-content:space-between;background:rgba(247,245,240,0.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);}
.nav-logo{font-family:var(--serif);font-weight:800;font-size:1rem;color:var(--ink);text-decoration:none;}
.nav-logo span{color:var(--accent);}
.nav-back{display:inline-flex;align-items:center;gap:.5rem;font-family:var(--mono);font-size:.78rem;color:var(--muted);text-decoration:none;padding:.4rem .85rem;border-radius:100px;border:1px solid var(--border);transition:all .2s;}
.nav-back:hover{background:var(--accent-light);color:var(--accent);border-color:var(--accent);}

/* HERO */
.mission-hero{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:6rem 4rem 4rem;gap:4rem;position:relative;overflow:hidden;}
.hero-bg{position:absolute;inset:0;z-index:0;background:radial-gradient(ellipse 60% 50% at 80% 50%,rgba(124,58,237,0.07) 0%,transparent 60%),radial-gradient(ellipse 40% 40% at 20% 80%,rgba(59,91,219,0.06) 0%,transparent 60%);}
.hero-content{position:relative;z-index:1;}
.hero-eyebrow{display:inline-flex;align-items:center;gap:.5rem;font-family:var(--mono);font-size:.75rem;color:var(--purple);letter-spacing:.08em;background:var(--purple-light);padding:.35rem 1rem;border-radius:100px;margin-bottom:1.75rem;animation:slideDown .6s ease both;}
.hero-eyebrow::before{content:'';width:6px;height:6px;background:var(--purple);border-radius:50%;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.5;transform:scale(.8);}}
h1{font-family:var(--serif);font-size:clamp(2.5rem,5vw,4rem);font-weight:800;line-height:1.05;letter-spacing:-.04em;color:var(--ink);animation:slideUp .7s .1s ease both;}
h1 em{font-style:italic;color:var(--accent);}
.hero-sub{margin:1.25rem 0 2rem;font-size:1.05rem;color:var(--muted);max-width:480px;animation:slideUp .7s .2s ease both;line-height:1.6;}
.hero-cta{display:flex;gap:.75rem;flex-wrap:wrap;animation:slideUp .7s .3s ease both;}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.7rem 1.5rem;border-radius:10px;font-family:var(--body);font-size:.9rem;font-weight:500;text-decoration:none;border:none;cursor:pointer;transition:all .2s;position:relative;overflow:hidden;}
.btn::after{content:'';position:absolute;inset:0;background:rgba(255,255,255,.15);opacity:0;transition:opacity .2s;}
.btn:hover::after{opacity:1;}
.btn-primary{background:var(--accent);color:white;box-shadow:0 4px 20px rgba(59,91,219,.3);}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(59,91,219,.4);}
.btn-ghost{background:var(--card);color:var(--text);border:1.5px solid var(--border);}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-2px);}
.btn-purple{background:var(--purple);color:white;box-shadow:0 4px 20px rgba(124,58,237,.3);}
.btn-purple:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(124,58,237,.4);}

/* CODE CARD */
.hero-visual{position:relative;z-index:1;animation:float .8s .4s ease both;}
.code-card{background:var(--ink);border-radius:20px;padding:2rem;box-shadow:0 30px 80px rgba(13,13,20,.25);overflow:hidden;position:relative;}
.code-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--purple),var(--accent),var(--green));}
.code-dots{display:flex;gap:6px;margin-bottom:1.25rem;}
.code-dots span{width:10px;height:10px;border-radius:50%;}
.code-dots span:nth-child(1){background:#ff5f57;}
.code-dots span:nth-child(2){background:#febc2e;}
.code-dots span:nth-child(3){background:#28c840;}
.code-line{font-family:var(--mono);font-size:.82rem;line-height:1.9;display:block;}
.c-comment{color:#636e7b;}.c-keyword{color:#c792ea;}.c-string{color:#c3e88d;}.c-func{color:#82aaff;}.c-var{color:#eeffff;}.c-op{color:#89ddff;}.c-class{color:#ffcb6b;}
.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1.25rem;}
.stat-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:1rem;text-align:center;}
.stat-num{font-family:var(--serif);font-size:1.5rem;font-weight:800;color:white;display:block;}
.stat-label{font-size:.72rem;color:#636e7b;font-family:var(--mono);}

/* SECTIONS */
.section{max-width:1000px;margin:0 auto;padding:6rem 2rem;}
.section-sep{width:100%;height:1px;background:var(--border);}
.tag{display:inline-flex;align-items:center;gap:.4rem;font-family:var(--mono);font-size:.72rem;color:var(--muted);letter-spacing:.12em;margin-bottom:1rem;}
.tag::before{content:'—';color:var(--accent);}
h2{font-family:var(--serif);font-size:clamp(2rem,4vw,2.8rem);font-weight:800;letter-spacing:-.04em;line-height:1.1;color:var(--ink);margin-bottom:.5rem;}
.section-lead{color:var(--muted);font-size:1rem;margin-bottom:3rem;max-width:560px;line-height:1.65;}

/* CONTEXTE CARDS */
.ctx-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.5rem;}
.ctx-card{background:var(--card);border:1.5px solid var(--border);border-radius:18px;padding:1.75rem;transition:all .3s;}
.ctx-card:hover{border-color:var(--accent);transform:translateY(-3px);box-shadow:0 12px 40px rgba(59,91,219,.08);}
.ctx-card.wide{grid-column:1/-1;}
.ctx-card.purple:hover{border-color:var(--purple);}
.card-icon{font-size:1.5rem;margin-bottom:.75rem;display:block;}
.ctx-card h3{font-family:var(--serif);font-size:1rem;font-weight:700;color:var(--ink);margin-bottom:.5rem;}
.ctx-card p{color:var(--muted);font-size:.92rem;line-height:1.7;}

/* ÉTAPES TIMELINE */
.steps-timeline{position:relative;padding-left:2.5rem;}
.steps-timeline::before{content:'';position:absolute;left:6px;top:8px;bottom:0;width:2px;background:linear-gradient(to bottom,var(--accent),var(--purple),transparent);}
.step-item{position:relative;margin-bottom:2.5rem;}
.step-dot{position:absolute;left:-2.35rem;top:5px;width:14px;height:14px;border-radius:50%;background:var(--card);border:2.5px solid var(--accent);transition:all .3s;}
.step-item:hover .step-dot{background:var(--accent);box-shadow:0 0 0 4px var(--accent-light);}
.step-num{font-family:var(--mono);font-size:.72rem;color:var(--accent);letter-spacing:.08em;margin-bottom:.3rem;}
.step-title{font-family:var(--serif);font-size:1.05rem;font-weight:700;color:var(--ink);margin-bottom:.25rem;}
.step-desc{color:var(--muted);font-size:.9rem;line-height:1.6;}
.step-badge{display:inline-flex;align-items:center;gap:.4rem;margin-top:.5rem;font-size:.75rem;font-family:var(--mono);padding:.25rem .7rem;border-radius:100px;}
.badge-done{background:var(--green-light);color:var(--green);}
.badge-wip{background:var(--accent-light);color:var(--accent);}
.badge-todo{background:var(--amber-light);color:var(--amber);}

/* CAS D'UTILISATION */
.cu-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;}
.cu-card{background:var(--card);border:1.5px solid var(--border);border-radius:16px;padding:1.25rem;transition:all .25s;position:relative;overflow:hidden;}
.cu-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;}
.cu-card.cu-connect::before{background:var(--accent);}
.cu-card.cu-personnel::before{background:var(--green);}
.cu-card.cu-absence::before{background:var(--purple);}
.cu-card:hover{transform:translateY(-3px);box-shadow:0 12px 35px rgba(13,13,20,.08);}
.cu-num{font-family:var(--mono);font-size:.7rem;color:var(--muted);letter-spacing:.1em;margin-bottom:.5rem;}
.cu-card h4{font-family:var(--serif);font-size:.95rem;font-weight:700;color:var(--ink);margin-bottom:.4rem;}
.cu-card p{color:var(--muted);font-size:.82rem;line-height:1.55;}

/* ARCHI MVC */
.archi-box{background:var(--ink);border-radius:20px;padding:2.5rem;position:relative;overflow:hidden;}
.archi-box::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--purple),var(--accent),var(--green));}
.archi-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:.75rem;align-items:center;}
.archi-layer{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:1.25rem;text-align:center;}
.archi-layer-name{font-family:var(--mono);font-size:.75rem;color:#82aaff;letter-spacing:.08em;margin-bottom:.4rem;}
.archi-layer-files{font-size:.78rem;color:#636e7b;line-height:1.7;}
.archi-arrow{text-align:center;color:#636e7b;font-size:1.2rem;}

/* TECHNOLOGIES */
.tech-wrap{display:flex;flex-wrap:wrap;gap:.75rem;}
.tech-tag{display:flex;align-items:center;gap:.5rem;background:var(--card);border:1.5px solid var(--border);border-radius:10px;padding:.5rem 1rem;font-size:.88rem;font-weight:500;color:var(--text);transition:all .2s;}
.tech-tag:hover{border-color:var(--accent);background:var(--accent-light);color:var(--accent);transform:translateY(-2px);}
.tech-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.dot-cs{background:var(--purple);}
.dot-db{background:var(--green);}
.dot-tool{background:var(--accent);}

/* CAPTURES */
.screens-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;}
.screen-card{background:var(--card);border:1.5px solid var(--border);border-radius:16px;overflow:hidden;transition:all .3s;}
.screen-card:hover{transform:translateY(-4px);box-shadow:0 16px 50px rgba(13,13,20,.1);border-color:var(--accent);}
.screen-preview{background:linear-gradient(135deg,#f0f4ff 0%,#e8edff 100%);height:160px;display:flex;align-items:center;justify-content:center;font-size:2.5rem;position:relative;overflow:hidden;}
.screen-preview::after{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,transparent 60%,rgba(59,91,219,.08));}
.screen-info{padding:1.25rem;}
.screen-info h4{font-family:var(--serif);font-size:.95rem;font-weight:700;color:var(--ink);margin-bottom:.3rem;}
.screen-info p{color:var(--muted);font-size:.83rem;line-height:1.55;}

/* COMMITS */
.commits-list{display:flex;flex-direction:column;gap:.75rem;}
.commit-item{display:flex;align-items:flex-start;gap:1rem;background:var(--card);border:1.5px solid var(--border);border-radius:14px;padding:1rem 1.25rem;transition:all .2s;}
.commit-item:hover{border-color:var(--accent);}
.commit-hash{font-family:var(--mono);font-size:.72rem;color:var(--accent);background:var(--accent-light);padding:.2rem .6rem;border-radius:6px;flex-shrink:0;margin-top:2px;}
.commit-msg{font-size:.9rem;color:var(--text);font-weight:500;}
.commit-sub{font-size:.8rem;color:var(--muted);margin-top:.15rem;}

/* LIENS */
.links-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;}
.link-card{background:var(--card);border:1.5px solid var(--border);border-radius:18px;padding:1.75rem;text-decoration:none;display:block;transition:all .3s;position:relative;overflow:hidden;}
.link-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;}
.link-card.github::before{background:var(--ink);}
.link-card.video::before{background:var(--purple);}
.link-card:hover{transform:translateY(-4px);box-shadow:0 16px 50px rgba(13,13,20,.1);}
.link-card.github:hover{border-color:var(--ink);}
.link-card.video:hover{border-color:var(--purple);}
.link-icon{font-size:2rem;margin-bottom:.75rem;display:block;}
.link-card h3{font-family:var(--serif);font-size:1.05rem;font-weight:700;color:var(--ink);margin-bottom:.4rem;}
.link-card p{color:var(--muted);font-size:.88rem;line-height:1.6;}
.link-arrow{display:inline-flex;align-items:center;gap:.4rem;margin-top:1rem;font-family:var(--mono);font-size:.78rem;color:var(--accent);}

/* VIDEO */
.video-wrapper{background:var(--ink);border-radius:20px;padding:2rem;position:relative;overflow:hidden;}
.video-wrapper::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--purple),var(--accent));}
.video-placeholder{background:rgba(255,255,255,.04);border:2px dashed rgba(255,255,255,.1);border-radius:14px;padding:4rem 2rem;text-align:center;}
.video-placeholder p{color:#636e7b;font-family:var(--mono);font-size:.85rem;line-height:1.8;}
.video-placeholder strong{color:#82aaff;}

/* FOOTER */
footer{text-align:center;padding:2rem;color:var(--muted);font-size:.78rem;font-family:var(--mono);border-top:1px solid var(--border);}

/* ANIMATIONS */
@keyframes slideDown{from{opacity:0;transform:translateY(-12px);}to{opacity:1;transform:none;}}
@keyframes slideUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:none;}}
@keyframes float{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:none;}}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .65s,transform .65s;}
.reveal.v{opacity:1;transform:none;}
.reveal-d1{transition-delay:.1s;}.reveal-d2{transition-delay:.2s;}.reveal-d3{transition-delay:.3s;}

@media(max-width:768px){
  .mission-hero{grid-template-columns:1fr;padding:5rem 1.5rem 3rem;}
  .hero-visual{display:none;}
  .ctx-grid,.links-grid,.screens-grid{grid-template-columns:1fr;}
  .ctx-card.wide{grid-column:1;}
  .cu-grid{grid-template-columns:1fr 1fr;}
  .archi-grid{grid-template-columns:1fr;}
  .archi-arrow{transform:rotate(90deg);}
  nav{padding:0 1.5rem;}
  .section{padding:4rem 1.5rem;}
}
</style>
</head>
